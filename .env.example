POSTGRES_USER=app
# Generated by ./scripts/setup.sh — an empty value is rejected by Compose.
POSTGRES_PASSWORD=
POSTGRES_DB=app
POSTGRES_PORT=5433

API_PORT=5001
FRONTEND_PORT=5173

# Server secrets — NOT usable as-is. Run ./scripts/setup.sh to generate a .env
# with strong random values; the API rejects these placeholders at startup.
JWT_SECRET=
SALT_PEPPER=
JWT_EXPIRES_IN_SECONDS=900

# Allowed browser origin for CORS, plus auth rate-limit window and ceiling.
FRONTEND_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# Per-account and per-IP budget for the MFA verify step.
AUTH_VERIFY_RATE_LIMIT_WINDOW_MS=900000
AUTH_VERIFY_RATE_LIMIT_MAX_PER_ACCOUNT=10
AUTH_VERIFY_RATE_LIMIT_MAX_PER_IP=30
