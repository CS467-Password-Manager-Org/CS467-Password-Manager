POSTGRES_USER=app
# Generated by ./scripts/setup.sh — an empty value is rejected by Compose.
POSTGRES_PASSWORD=
POSTGRES_DB=app
POSTGRES_PORT=5433

API_PORT=5001
FRONTEND_PORT=5173

# Server secrets — NOT usable as-is. Run ./scripts/setup.sh to generate a .env
# with strong random values; the API rejects these placeholders at startup.
JWT_SECRET=
SALT_PEPPER=
JWT_EXPIRES_IN_SECONDS=900

# Allowed browser origin for CORS, plus auth rate-limit window and ceiling.
FRONTEND_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# Per-account and per-IP budget for the MFA verify step.
AUTH_VERIFY_RATE_LIMIT_WINDOW_MS=900000
AUTH_VERIFY_RATE_LIMIT_MAX_PER_ACCOUNT=10
AUTH_VERIFY_RATE_LIMIT_MAX_PER_IP=30

# Number of reverse proxies in front of the API. Leave at 0 when the browser
# reaches the API directly, as it does with `docker compose up`. Rate limits key
# on req.ip, so a wrong value hurts either way: too low and every user behind the
# proxy shares one bucket, too high and a client can spoof X-Forwarded-For to
# give itself a fresh bucket per request. The dev overlay sets this to 1 because
# the Vite dev server proxies /api.
TRUST_PROXY_HOPS=0
